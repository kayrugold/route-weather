#
# Route Weather Fast Passenger Car Profile (Offline BRouter)
# Optimized for fast statewide & cross-country offline routing (OsmPathModel).
#
---context:global

assign validForCars        = true
assign turnInstructionMode = 3
assign pass1coefficient    = 2.2
assign pass2coefficient    = 0
assign downhillcost        = 0
assign uphillcost          = 0

---context:way

assign isresidential = or highway=residential|living_street living_street=yes
assign badoneway = if reversedirection=yes then ( if oneway= then junction=roundabout else oneway=yes|true|1 ) else oneway=-1

assign caraccess =
  if badoneway then 0
  else if or motor_vehicle=no|private access=no|private then 0
  else if highway=motorway|motorway_link|trunk|trunk_link|primary|primary_link|secondary|secondary_link|tertiary|tertiary_link|unclassified|service then 1
  else if isresidential then 1
  else if route=ferry then 1
  else 0

assign initialcost =
  if not caraccess then 1000000
  else if route=ferry then 10000
  else if isresidential then 120
  else if highway=service then 200
  else 0

assign costfactor =
  if not caraccess then 10000
  else if highway=motorway|motorway_link then 1.0
  else if highway=trunk|trunk_link then 1.18
  else if highway=primary|primary_link then 1.45
  else if highway=secondary|secondary_link then 2.2
  else if highway=tertiary|tertiary_link then 3.5
  else if highway=unclassified then 5.5
  else if isresidential then 12.0
  else if highway=service then 18.0
  else 25.0

assign priorityclassifier =
  if      ( highway=motorway                  ) then  30
  else if ( highway=motorway_link             ) then  29
  else if ( highway=trunk                     ) then  28
  else if ( highway=trunk_link                ) then  27
  else if ( highway=primary                   ) then  26
  else if ( highway=primary_link              ) then  25
  else if ( highway=secondary                 ) then  24
  else if ( highway=secondary_link            ) then  23
  else if ( highway=tertiary                  ) then  22
  else if ( highway=tertiary_link             ) then  21
  else if ( highway=unclassified              ) then  20
  else if ( isresidential                     ) then   6
  else if ( highway=service                   ) then   6
  else 0

assign isgoodoneway = if reversedirection=yes then oneway=-1
                      else if oneway= then junction=roundabout else oneway=yes|true|1
assign isroundabout = junction=roundabout
assign islinktype   = highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link
assign isgoodforcars = greater priorityclassifier 5

assign classifiermask add          badoneway
                      add multiply isgoodoneway   2
                      add multiply isroundabout   4
                      add multiply islinktype     8
                      add multiply isgoodforcars 16
                          multiply isresidential 32

---context:node

assign initialcost =
  if barrier=gate|bollard|lift_gate|cycle_barrier then 1000000
  else 0
